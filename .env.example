# Copernicus Data Space Ecosystem credentials
# Register free at: https://dataspace.copernicus.eu
CDSE_USERNAME=your@email.com
CDSE_PASSWORD=yourpassword

# Optional: S3 credentials for faster direct downloads
# Generate at: dataspace.copernicus.eu → your account → S3 credentials
CDSE_S3_KEY=
CDSE_S3_SECRET=

# Optional: OpenTopography API key for higher-resolution DEMs (LiDAR)
# Free key at: opentopography.org/myopentopo
OPENTOPO_KEY=
